{
  "name": "cf-ai-supply-chain-copilot",
  "version": "1.0.0",
  "private": true,
  "description": "AI program-management copilot for hardware supply chain deployments, built on Cloudflare Agents, Durable Objects and Workers AI",
  "keywords": [
    "agents",
    "ai",
    "cloudflare"
  ],
  "license": "MIT",
  "author": "sidbetatester (https://github.com/sidbetatester)",
  "repository": "github:sidbetatester/cf-ai-supply-chain-copilot",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "start": "vite dev",
    "deploy": "vite build && wrangler deploy",
    "types": "wrangler types env.d.ts",
    "format": "oxfmt --write .",
    "lint": "oxlint src/ plugins/",
    "check": "oxfmt --check . && oxlint src/ plugins/ && tsc"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.293",
    "@cloudflare/ai-chat": "^0.12.0",
    "@cloudflare/kumo": "^2.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@streamdown/code": "^1.1.1",
    "agents": "^0.24.0",
    "ai": "^6.0.197",
    "papaparse": "^5.7.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "streamdown": "^2.5.0",
    "workers-ai-provider": "^3.2.1",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@cloudflare/vite-plugin": "^1.46.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "wrangler": "^4.113.0"
  },
  "allowScripts": {
    "core-js-pure@3.50.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260921.1": true,
    "sharp@0.35.4": true,
    "fsevents@2.3.3": true
  }
}
