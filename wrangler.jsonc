{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-ai-supply-chain-copilot",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"]
  },
  // Only admin Settings are stored on the server; chats and project data
  // live in each user's browser.
  "durable_objects": {
    "bindings": [{ "class_name": "SettingsAgent", "name": "SettingsAgent" }]
  },
  // Bounds Workers AI spend and admin-key guessing (see src/agents/guards.ts).
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "migrations": [
    {
      "new_sqlite_classes": ["ProjectAgent", "ChatAgent"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["SettingsAgent"],
      "tag": "v2"
    },
    {
      // Chats and project data moved to the browser: delete the per-project
      // and per-chat Durable Objects along with everything they stored.
      "deleted_classes": ["ProjectAgent", "ChatAgent"],
      "tag": "v3"
    }
  ]
}
