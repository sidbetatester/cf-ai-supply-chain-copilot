{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-ai-supply-chain-copilot",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"]
  },
  // Only admin Settings and today's AI usage counters are stored on the
  // server; chats and project data live in each user's browser.
  "durable_objects": {
    "bindings": [
      { "class_name": "SettingsAgent", "name": "SettingsAgent" },
      { "class_name": "UsageLimiter", "name": "UsageLimiter" }
    ]
  },
  "vars": {
    // Keep Workers AI inside the free plan's 10,000 neurons per day (reset
    // 00:00 UTC). Headroom covers local development, which uses the same
    // account allocation.
    "AI_DAILY_NEURON_BUDGET": "9000",
    // Largest share of the daily budget one client (IP) may use.
    "AI_CLIENT_DAILY_SHARE": "0.2"
  },
  "ratelimits": [
    // Bursts of AI requests per client (the daily budget is UsageLimiter).
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    },
    // Admin-key guessing on Settings unlock.
    {
      "name": "UNLOCK_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "migrations": [
    {
      "new_sqlite_classes": ["ProjectAgent", "ChatAgent"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["SettingsAgent"],
      "tag": "v2"
    },
    {
      // Chats and project data moved to the browser: delete the per-project
      // and per-chat Durable Objects along with everything they stored.
      "deleted_classes": ["ProjectAgent", "ChatAgent"],
      "tag": "v3"
    },
    {
      "new_sqlite_classes": ["UsageLimiter"],
      "tag": "v4"
    }
  ]
}
